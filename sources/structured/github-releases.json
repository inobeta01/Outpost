{
  "id": "github.com/anthropics/anthropic-sdk-typescript",
  "kind": "structured",
  "owner": "@vendor-bot",
  "source_type": "github_releases",
  "fetch": {
    "auth": "github_token_env",
    "rate_limit": "5000/h"
  },
  "endpoints": {
    "releases": {
      "url": "https://api.github.com/repos/{owner}/{repo}/releases",
      "kind": "list",
      "variables": {
        "owner": "anthropics",
        "repo": "anthropic-sdk-typescript"
      }
    }
  },
  "security": {
    "allowed_domains": ["api.github.com"]
  },
  "firecrawl": false
}
