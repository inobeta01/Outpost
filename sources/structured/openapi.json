{
  "id": "github.com/stripe/openapi",
  "kind": "structured",
  "owner": "@vendor-bot",
  "source_type": "openapi",
  "fetch": {
    "auth": "none",
    "rate_limit": "1000/h"
  },
  "endpoints": {
    "openapi": {
      "url": "https://raw.githubusercontent.com/{owner}/{repo}/master/openapi/spec3.json",
      "kind": "spec",
      "variables": {
        "owner": "stripe",
        "repo": "openapi"
      }
    }
  },
  "security": {
    "allowed_domains": ["raw.githubusercontent.com", "github.com"]
  },
  "firecrawl": false
}
