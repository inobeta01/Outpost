{
  "id": "github.com/stripe/stripe-node",
  "kind": "structured",
  "owner": "@vendor-bot",
  "fetch": {
    "auth": "github_token_env",
    "rate_limit": "5000/h"
  },
  "endpoints": {
    "openapi": {
      "url": "https://raw.githubusercontent.com/{owner}/{repo}/HEAD/openapi.yaml",
      "kind": "spec",
      "variables": {
        "owner": "stripe",
        "repo": "stripe-node"
      }
    }
  },
  "firecrawl": false
}
